{
  "description": "sdd-flow: PreToolUse bloquea comandos de dispositivo/emulador/simulador y tests instrumentados sin aprobación (regla de oro 8). PostToolUse captura fallos de build/test a engram (memoria viva).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require-device-approval.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/capture-to-engram.py\"",
            "timeout": 12
          }
        ]
      }
    ]
  }
}
